<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="550.0" style="-fx-background-color: #F4F4F4;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <VBox alignment="TOP_CENTER" layoutX="125.0" layoutY="45.0" prefHeight="310.0" prefWidth="300.0" spacing="15.0" style="-fx-background-color: #FFFFFF; -fx-border-color: #CCCCCC; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 20;">
         <children>
            
            <Label text="EDIT PROFILE" textFill="#333333">
               <font>
                  <Font name="System Bold" size="18.0" />
               </font>
            </Label>

            <VBox spacing="5.0">
               <children>
                  <Label text="Name" textFill="#555555">
                     <font>
                        <Font size="13.0" />
                     </font>
                  </Label>
                  <TextField style="-fx-background-radius: 5; -fx-border-color: #BBBBBB; -fx-border-radius: 5;" />
               </children>
            </VBox>

            <VBox spacing="5.0">
               <children>
                  <Label text="Email" textFill="#555555">
                     <font>
                        <Font size="13.0" />
                     </font>
                  </Label>
                  <TextField style="-fx-background-radius: 5; -fx-border-color: #BBBBBB; -fx-border-radius: 5;" />
               </children>
            </VBox>

            <VBox spacing="5.0">
               <children>
                  <Label text="Username" textFill="#555555">
                     <font>
                        <Font size="13.0" />
                     </font>
                  </Label>
                  <TextField style="-fx-background-radius: 5; -fx-border-color: #BBBBBB; -fx-border-radius: 5;" />
               </children>
            </VBox>

            <Button mnemonicParsing="false" prefWidth="80.0" style="-fx-background-color: #E0E0E0; -fx-background-radius: 15; -fx-border-color: #999999; -fx-border-radius: 15;" text="Save" textFill="#333333">
               <font>
                  <Font size="13.0" />
               </font>
            </Button>
            
         </children>
      </VBox>
   </children>
</AnchorPane>