<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.TilePane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane id="AnchorPane" prefHeight="720.0" prefWidth="1280.0" style="-fx-background-color: #FAFAFA;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.tes.pembeli.PembeliHomepageController">
   <children>
      <HBox prefHeight="720.0" prefWidth="1280.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            
            <fx:include source="../components/NavbarPembeli.fxml" />
            
            <ScrollPane fitToWidth="true" prefHeight="720.0" prefWidth="1040.0" style="-fx-background-color: transparent; -fx-background-insets: 0;" HBox.hgrow="ALWAYS">
               <content>
                  <VBox alignment="TOP_CENTER" fillWidth="false" prefWidth="1020.0" spacing="25.0">
                     <padding>
                        <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
                     </padding>
                     <children>
                        
                        <TextField fx:id="txtSearch" onAction="#handleSearch" prefHeight="46.0" prefWidth="850.0" promptText="Search your favorite events..." style="-fx-background-color: #FFFFFF; -fx-background-radius: 14; -fx-border-color: #E5E5EA; -fx-border-radius: 14; -fx-padding: 0 20 0 20;">
                           <font><Font size="14.0" /></font>
                        </TextField>
                        
                        <HBox alignment="CENTER" prefWidth="850.0" spacing="12.0">
                           <children>
                              <Button fx:id="btnFilterAll" mnemonicParsing="false" onAction="#handleCategoryFilter" style="-fx-background-color: #111111; -fx-text-fill: white; -fx-background-radius: 20; -fx-padding: 8 18 8 18; -fx-cursor: hand;" text="All">
                                 <font><Font name="System Bold" size="14.0" /></font>
                              </Button>
                              <Button fx:id="btnFilterConcert" mnemonicParsing="false" onAction="#handleCategoryFilter" style="-fx-background-color: #FFFFFF; -fx-text-fill: #444444; -fx-background-radius: 20; -fx-border-color: #E5E5EA; -fx-border-radius: 20; -fx-padding: 8 18 8 18; -fx-cursor: hand;" text="Concert">
                                 <font><Font name="System Medium" size="14.0" /></font>
                              </Button>
                              <Button fx:id="btnFilterExpo" mnemonicParsing="false" onAction="#handleCategoryFilter" style="-fx-background-color: #FFFFFF; -fx-text-fill: #444444; -fx-background-radius: 20; -fx-border-color: #E5E5EA; -fx-border-radius: 20; -fx-padding: 8 18 8 18; -fx-cursor: hand;" text="Expo">
                                 <font><Font name="System Medium" size="14.0" /></font>
                              </Button>
                              <Button fx:id="btnFilterSeminar" mnemonicParsing="false" onAction="#handleCategoryFilter" style="-fx-background-color: #FFFFFF; -fx-text-fill: #444444; -fx-background-radius: 20; -fx-border-color: #E5E5EA; -fx-border-radius: 20; -fx-padding: 8 18 8 18; -fx-cursor: hand;" text="Seminar">
                                 <font><Font name="System Medium" size="14.0" /></font>
                              </Button>
                              <Button fx:id="btnFilterFestival" mnemonicParsing="false" onAction="#handleCategoryFilter" style="-fx-background-color: #FFFFFF; -fx-text-fill: #444444; -fx-background-radius: 20; -fx-border-color: #E5E5EA; -fx-border-radius: 20; -fx-padding: 8 18 8 18; -fx-cursor: hand;" text="Festival">
                                 <font><Font name="System Medium" size="14.0" /></font>
                              </Button>
                           </children>
                        </HBox>
                        
                        <VBox alignment="CENTER" prefHeight="200.0" prefWidth="850.0" spacing="12.0" style="-fx-background-color: #FFFFFF; -fx-background-radius: 24; -fx-border-color: #E5E5EA; -fx-border-radius: 24; -fx-padding: 30; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.02), 10, 0, 0, 5);">
                           <children>
                              <Label text="NEED HELP?" textFill="#111111">
                                 <font>
                                    <Font name="System Bold" size="18.0" />
                                 </font>
                              </Label>
                              <Label text="Please contact V-PASS Customer Service if you experience any transaction or ticketing issues." textFill="#666666">
                                 <font>
                                    <Font size="13.0" />
                                 </font>
                                 <VBox.margin>
                                    <Insets bottom="10.0" />
                                 </VBox.margin>
                              </Label>
                              <HBox alignment="CENTER" spacing="40.0">
                                 <children>
                                    <VBox alignment="CENTER" spacing="4.0">
                                       <children>
                                          <Label text="Email Address" textFill="#8E8E93">
                                             <font><Font name="System Medium" size="12.0" /></font>
                                          </Label>
                                          <Label text="adminvpass@fake.com" textFill="#A800FF">
                                             <font><Font name="System Bold" size="15.0" /></font>
                                          </Label>
                                       </children>
                                    </VBox>
                                    <VBox alignment="CENTER" spacing="4.0">
                                       <children>
                                          <Label text="WhatsApp Hotline" textFill="#8E8E93">
                                             <font><Font name="System Medium" size="12.0" /></font>
                                          </Label>
                                          <Label text="+62 8XXXXXXXXX" textFill="#FF5E00">
                                             <font><Font name="System Bold" size="15.0" /></font>
                                          </Label>
                                       </children>
                                    </VBox>
                                 </children>
                              </HBox>
                           </children>
                        </VBox>
                        
                        <TilePane fx:id="tilePaneEvent" hgap="15.0" prefWidth="850.0" vgap="20.0" />
                        
                     </children>
                  </VBox>
               </content>
            </ScrollPane>
            
         </children>
      </HBox>
   </children>
</AnchorPane> 