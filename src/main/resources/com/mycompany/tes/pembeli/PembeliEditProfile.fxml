<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane id="AnchorPane" prefHeight="720.0" prefWidth="1280.0" style="-fx-background-color: #FAFAFA;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.tes.pembeli.PembeliEditProfileController">
   <children>
      <HBox prefHeight="720.0" prefWidth="1280.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            
            <fx:include source="../components/NavbarPembeli.fxml" />
            
            <ScrollPane fitToWidth="true" prefHeight="720.0" prefWidth="1040.0" style="-fx-background-color: transparent; -fx-background-insets: 0;" HBox.hgrow="ALWAYS">
               <content>
                  <VBox alignment="CENTER" fillWidth="false" prefWidth="1020.0">
                     <padding>
                        <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
                     </padding>
                     <children>
                        
                        <VBox alignment="TOP_CENTER" prefWidth="460.0" spacing="14.0" style="-fx-background-color: #FFFFFF; -fx-background-radius: 24; -fx-border-color: #E5E5EA; -fx-border-radius: 24; -fx-padding: 35 40 35 40; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.03), 10, 0, 0, 5));">
                           <children>
                              
                              <Label text="EDIT PROFILE" textFill="#111111">
                                 <font><Font name="System Bold" size="22.0" /></font>
                                 <VBox.margin><Insets bottom="10.0" /></VBox.margin>
                              </Label>
                              
                              <VBox prefWidth="380.0" spacing="4.0">
                                 <children>
                                    <Label text="Name" textFill="#444444"><font><Font name="System Bold" size="13.0" /></font></Label>
                                    <TextField fx:id="txtName" prefHeight="36.0" style="-fx-background-color: #FAFAFA; -fx-background-radius: 10; -fx-border-color: #E5E5EA; -fx-border-radius: 10; -fx-padding: 0 12 0 12;" />
                                 </children>
                              </VBox>
                              
                              <VBox prefWidth="380.0" spacing="4.0">
                                 <children>
                                    <Label text="Email" textFill="#444444"><font><Font name="System Bold" size="13.0" /></font></Label>
                                    <TextField fx:id="txtEmail" prefHeight="36.0" style="-fx-background-color: #FAFAFA; -fx-background-radius: 10; -fx-border-color: #E5E5EA; -fx-border-radius: 10; -fx-padding: 0 12 0 12;" />
                                 </children>
                              </VBox>
                              
                              <VBox prefWidth="380.0" spacing="4.0">
                                 <children>
                                    <Label text="Username" textFill="#444444"><font><Font name="System Bold" size="13.0" /></font></Label>
                                    <TextField fx:id="txtUsername" prefHeight="36.0" style="-fx-background-color: #FAFAFA; -fx-background-radius: 10; -fx-border-color: #E5E5EA; -fx-border-radius: 10; -fx-padding: 0 12 0 12;" />
                                 </children>
                                 <VBox.margin><Insets bottom="10.0" /></VBox.margin>
                              </VBox>
                              
                              <VBox alignment="CENTER" prefWidth="380.0" spacing="10.0">
                                 <children>
                                    <Button fx:id="btnSave" mnemonicParsing="false" prefHeight="42.0" prefWidth="380.0" style="-fx-background-color: #111111; -fx-text-fill: white; -fx-background-radius: 12; -fx-cursor: hand; -fx-font-weight: bold;" text="SAVE CHANGES" />
                                    <Button mnemonicParsing="false" onAction="#kembaliKeProfile" prefHeight="30.0" prefWidth="380.0" style="-fx-background-color: transparent; -fx-text-fill: #666666; -fx-cursor: hand; -fx-font-weight: bold;" text="Cancel" />
                                 </children>
                              </VBox>
                              
                           </children>
                        </VBox>
                        
                     </children>
                  </VBox> 
               </content>
            </ScrollPane>
         </children>
      </HBox>
   </children>
</AnchorPane>