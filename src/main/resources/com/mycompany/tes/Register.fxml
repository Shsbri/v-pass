<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane id="AnchorPane" prefHeight="720.0" prefWidth="1280.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.tes.RegisterController">
   <children>
      <VBox alignment="CENTER" layoutX="14.0" layoutY="14.0" prefHeight="530.0" prefWidth="390.0" style="-fx-background-color: white; -fx-border-color: black; -fx-border-radius: 20; -fx-background-radius: 20; -fx-border-width: 1;">
         <children>
            <Label text="REGIST V-PASS">
               <font>
                  <Font name="System Bold" size="24.0" />
               </font>
               <VBox.margin>
                  <Insets bottom="10.0" top="10.0" />
               </VBox.margin>
            </Label>
            <VBox prefHeight="426.0" prefWidth="389.0">
               <children>
                  <Label text="Name">
                     <font>
                        <Font name="System Bold" size="18.0" />
                     </font>
                  </Label>
                  <TextField fx:id="txtName" prefHeight="26.0" prefWidth="303.0" style="-fx-background-radius: 15;" />
                  <Label text="Email">
                     <font>
                        <Font name="System Bold" size="18.0" />
                     </font>
                  </Label>
                  <TextField fx:id="txtEmail" prefHeight="26.0" prefWidth="303.0" style="-fx-background-radius: 15;" />
                  <Label text="Username">
                     <font>
                        <Font name="System Bold" size="18.0" />
                     </font>
                  </Label>
                  <TextField fx:id="txtUsername" prefHeight="26.0" prefWidth="303.0" style="-fx-background-radius: 15;" />
                  <Label text="Password">
                     <font>
                        <Font name="System Bold" size="18.0" />
                     </font>
                  </Label>
                  <PasswordField fx:id="txtPassword" prefHeight="26.0" prefWidth="303.0" style="-fx-background-radius: 15;" />
                  <Label text="Confirm Password">
                     <font>
                        <Font name="System Bold" size="18.0" />
                     </font>
                  </Label>
                  <PasswordField fx:id="txtConfirm" prefHeight="26.0" prefWidth="303.0" style="-fx-background-radius: 15;" />
                  <Label text="Pet Name">
                     <font>
                        <Font name="System Bold" size="18.0" />
                     </font>
                  </Label>
                  <TextField fx:id="txtPet" prefHeight="26.0" prefWidth="303.0" style="-fx-background-radius: 15;" />
                  <VBox alignment="CENTER" prefHeight="80.0" prefWidth="359.0" spacing="10.0">
                     <children>
                        <Button fx:id="btnRegist" mnemonicParsing="false" onAction="#ActRegist" style="-fx-background-radius: 15;" text="Regist">
                           <font>
                              <Font name="System Bold" size="18.0" />
                           </font>
                        </Button>
                        <Hyperlink fx:id="linkToLogin" onAction="#handleGoToLogin" text="Sudah punya akun? Login" style="-fx-text-fill: #0078D7; -fx-font-weight: bold;" />
                     </children>
                     <VBox.margin>
                        <Insets top="15.0" />
                     </VBox.margin>
                  </VBox>
               </children>
               <VBox.margin>
                  <Insets left="15.0" right="15.0" />
               </VBox.margin>
            </VBox>
         </children>
      </VBox>
   </children>
</AnchorPane>