<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Line?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" prefHeight="559.0" prefWidth="150.0" spacing="15.0" style="-fx-background-color: #F5F5F5; -fx-border-color: #D3D3D3; -fx-border-width: 0 1 0 0; -fx-padding: 20 10 20 10;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.tes.components.NavbarPembeliController">
   <children>
      
      <Label text="V-PASS" textFill="BLACK">
         <font><Font name="System Bold" size="20.0" /></font>
      </Label>
      
      <Line endX="110.0" stroke="#D3D3D3" />
      
      <Button fx:id="btnHome" mnemonicParsing="false" onAction="#keHomepage" prefWidth="120.0" style="-fx-background-color: white; -fx-border-color: black; -fx-border-radius: 5; -fx-background-radius: 5;" text="Homepage">
         <font><Font name="System Bold" size="14.0" /></font>
      </Button>
      
      <Button fx:id="btnTicket" mnemonicParsing="false" onAction="#keMyTicket" prefWidth="120.0" style="-fx-background-color: transparent;" text="My Ticket">
         <font><Font size="14.0" /></font>
      </Button>
      
      <Button fx:id="btnHistory" mnemonicParsing="false" onAction="#keHistory" prefWidth="120.0" style="-fx-background-color: transparent;" text="History">
         <font><Font size="14.0" /></font>
      </Button>
      
      <VBox VBox.vgrow="ALWAYS" />
      
      <Line endX="110.0" stroke="#D3D3D3" />
      
      <Button fx:id="btnProfile" mnemonicParsing="false" onAction="#keProfile" prefWidth="120.0" style="-fx-background-color: transparent;" text="Profile">
         <font><Font size="14.0" /></font>
      </Button>
      
      <Button mnemonicParsing="false" prefWidth="100.0" style="-fx-background-radius: 10; -fx-background-color: #E0E0E0;" text="LOGOUT">
         <font><Font name="System Bold" size="12.0" /></font>
      </Button>
      
   </children>
</VBox>