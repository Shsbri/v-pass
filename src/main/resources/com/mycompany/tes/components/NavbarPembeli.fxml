<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Line?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" prefHeight="720.0" prefWidth="240.0" spacing="12.0" style="-fx-background-color: #FFFFFF; -fx-border-color: #EBEBEB; -fx-border-width: 0 1 0 0; -fx-padding: 30 20 30 20;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.tes.components.NavbarPembeliController">
   <children>
      
      <VBox alignment="CENTER" spacing="8.0">
         <children>
            <ImageView fx:id="imgLogo" fitHeight="60.0" fitWidth="60.0" pickOnBounds="true" preserveRatio="true">
               <VBox.margin>
                  <Insets bottom="2.0" />
               </VBox.margin>
            </ImageView>
            <Label text="V-PASS" textFill="#111111">
               <font>
                  <Font name="System Bold" size="22.0" />
               </font>
            </Label>
         </children>
         <VBox.margin>
            <Insets bottom="15.0" />
         </VBox.margin>
      </VBox>
      
      <Line endX="160.0" stroke="#F0F0F0" />
      
      <Button fx:id="btnHome" mnemonicParsing="false" onAction="#keHomepage" prefHeight="40.0" prefWidth="200.0" style="-fx-background-color: transparent; -fx-text-fill: #666666; -fx-cursor: hand;" text="Homepage">
         <font><Font name="System Medium" size="14.0" /></font>
      </Button>
      
      <Button fx:id="btnTicket" mnemonicParsing="false" onAction="#keMyTicket" prefHeight="40.0" prefWidth="200.0" style="-fx-background-color: transparent; -fx-text-fill: #666666; -fx-cursor: hand;" text="My Ticket">
         <font><Font name="System Medium" size="14.0" /></font>
      </Button>
      
      <Button fx:id="btnHistory" mnemonicParsing="false" onAction="#keHistory" prefHeight="40.0" prefWidth="200.0" style="-fx-background-color: transparent; -fx-text-fill: #666666; -fx-cursor: hand;" text="History">
         <font><Font name="System Medium" size="14.0" /></font>
      </Button>
      
      <VBox VBox.vgrow="ALWAYS" />
      
      <Line endX="160.0" stroke="#F0F0F0" />
      
      <Button fx:id="btnProfile" mnemonicParsing="false" onAction="#keProfile" prefHeight="40.0" prefWidth="200.0" style="-fx-background-color: transparent; -fx-text-fill: #666666; -fx-cursor: hand;" text="Profile">
         <font><Font name="System Medium" size="14.0" /></font>
      </Button>
      
      <Button mnemonicParsing="false" onAction="#onLogoutClick" prefHeight="40.0" prefWidth="200.0" style="-fx-background-color: #F5F5F7; -fx-background-radius: 12; -fx-text-fill: #FF3B30; -fx-cursor: hand;" text="LOGOUT">
         <font><Font name="System Bold" size="14.0" /></font>
      </Button>
      
   </children>
</VBox>