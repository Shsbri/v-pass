<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="920.0" style="-fx-background-color: #F4F4F4;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.tes.tes.PembeliEditProfileController">
   <children>
      <VBox alignment="TOP_CENTER" fillWidth="false" layoutX="14.0" layoutY="14.0" prefHeight="572.0" prefWidth="435.0" spacing="15.0" style="-fx-background-color: #FFFFFF; -fx-border-color: #CCCCCC; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 20;">
         <children>
            
            <Label text="EDIT PROFILE" textFill="#333333">
               <font>
                  <Font name="System Bold" size="24.0" />
               </font>
            </Label>

            <VBox spacing="5.0">
               <children>
                  <Label text="Name" textFill="#555555">
                     <font>
                        <Font size="18.0" />
                     </font>
                  </Label>
                  <TextField prefHeight="27.0" prefWidth="451.0" style="-fx-background-radius: 5; -fx-border-color: #BBBBBB; -fx-border-radius: 5;" />
               </children>
            </VBox>

            <VBox prefHeight="51.0" prefWidth="456.0" spacing="5.0">
               <children>
                  <Label text="Email" textFill="#555555">
                     <font>
                        <Font size="18.0" />
                     </font>
                  </Label>
                  <TextField prefHeight="27.0" prefWidth="458.0" style="-fx-background-radius: 5; -fx-border-color: #BBBBBB; -fx-border-radius: 5;" />
               </children>
            </VBox>

            <VBox spacing="5.0">
               <children>
                  <Label text="Username" textFill="#555555">
                     <font>
                        <Font size="18.0" />
                     </font>
                  </Label>
                  <TextField prefHeight="27.0" prefWidth="457.0" style="-fx-background-radius: 5; -fx-border-color: #BBBBBB; -fx-border-radius: 5;" />
               </children>
            </VBox>

            <Button id="saveButton" mnemonicParsing="false" onAction="#handleSave" prefWidth="80.0" style="-fx-background-radius: 10;" text="Save" textFill="#333333">
               <font>
                  <Font size="15.0" />
               </font>
               <VBox.margin>
                  <Insets bottom="50.0" left="50.0" right="50.0" top="50.0" />
               </VBox.margin>
            </Button>
            
         </children>
      </VBox>
   </children>
</AnchorPane>
