<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane id="AnchorPane" prefHeight="380.0" prefWidth="356.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.tes.LoginController">
   <children>
      <VBox alignment="CENTER" prefHeight="380.0" prefWidth="368.0" style="-fx-background-color: white; -fx-border-color: black; -fx-border-radius: 20; -fx-background-radius: 20; -fx-border-width: 1;">
         <children>
            <Label alignment="CENTER" text="LOGIN V-PASS">
               <font>
                  <Font name="System Bold" size="26.0" />
               </font>
               <VBox.margin>
                  <Insets bottom="10.0" />
               </VBox.margin>
            </Label>
            <VBox prefHeight="142.0" prefWidth="366.0">
               <children>
                  <Label text="Username">
                     <font>
                        <Font name="System Bold" size="18.0" />
                     </font>
                  </Label>
                  <TextField fx:id="txtUsername" prefHeight="26.0" prefWidth="293.0" style="-fx-background-radius: 15;" />
                  <Label text="Password">
                     <font>
                        <Font name="System Bold" size="18.0" />
                     </font>
                  </Label>
                  <PasswordField fx:id="txtPassword" prefHeight="26.0" prefWidth="309.0" style="-fx-background-radius: 15;" />
               </children>
               <VBox.margin>
                  <Insets left="15.0" right="15.0" />
               </VBox.margin>
            </VBox>
            <VBox alignment="CENTER" prefHeight="80.0" prefWidth="366.0" spacing="10.0">
               <children>
                  <Button fx:id="btnLogin" alignment="CENTER" mnemonicParsing="false" onAction="#ActLogin" text="LOGIN">
                     <font>
                        <Font name="System Bold" size="20.0" />
                     </font>
                  </Button>
                  <Hyperlink fx:id="linkToRegister" onAction="#handleGoToRegister" text="Belum punya akun? Registrasi" style="-fx-text-fill: #0078D7; -fx-font-weight: bold;" />
               </children>
            </VBox>
         </children>
      </VBox>
   </children>
</AnchorPane>