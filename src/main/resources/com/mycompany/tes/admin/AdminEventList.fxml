<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane id="AnchorPane" prefHeight="720.0" prefWidth="1280.0" style="-fx-background-color: #FAFAFA;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.tes.admin.AdminEventListController">
   <children>
      <HBox prefHeight="720.0" prefWidth="1280.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            
            <fx:include source="../components/NavbarAdmin.fxml" />
            
            <ScrollPane fitToWidth="true" prefHeight="720.0" prefWidth="1040.0" style="-fx-background-color: transparent; -fx-background-insets: 0;" HBox.hgrow="ALWAYS">
               <content>
                  <VBox spacing="30.0">
                     <padding>
                        <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
                     </padding>
                     <children>
                        
                        <Label text="Management Event" textFill="#111111">
                           <font><Font name="System Bold" size="28.0" /></font>
                        </Label>
                        
                        <HBox alignment="CENTER_LEFT" maxHeight="40.0" minHeight="40.0" prefHeight="40.0" prefWidth="960.0" spacing="15.0">
                           <children>
                              <ComboBox fx:id="cmbTime" onAction="#handleFilter" maxHeight="38.0" minHeight="38.0" prefHeight="38.0" prefWidth="140.0" promptText="All Time" style="-fx-background-color: #FFFFFF; -fx-background-radius: 12; -fx-border-color: #E5E5EA; -fx-border-radius: 12; -fx-padding: 0 5 0 5; -fx-cursor: hand;" />
                              
                              <ComboBox fx:id="cmbCategory" onAction="#handleFilter" maxHeight="38.0" minHeight="38.0" prefHeight="38.0" prefWidth="140.0" promptText="All Category" style="-fx-background-color: #FFFFFF; -fx-background-radius: 12; -fx-border-color: #E5E5EA; -fx-border-radius: 12; -fx-padding: 0 5 0 5; -fx-cursor: hand;" />
                              
                              <Region HBox.hgrow="ALWAYS" />
                              
                              <Button maxHeight="40.0" minHeight="40.0" mnemonicParsing="false" onAction="#keFormAddEvent" prefHeight="40.0" style="-fx-background-color: linear-gradient(to right, #FF5E00, #A800FF); -fx-text-fill: white; -fx-background-radius: 12; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 0 22 0 22;" text="+ Add Event">
                                 <font><Font size="14.0" /></font>
                              </Button>
                           </children>
                        </HBox>
                        
                        <VBox prefWidth="960.0" style="-fx-background-color: #FFFFFF; -fx-background-radius: 20; -fx-border-color: #E5E5EA; -fx-border-radius: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.02), 15, 0, 0, 5); -fx-overflow: hidden;">
                           <children>
                              
                              <HBox alignment="CENTER_LEFT" maxHeight="50.0" minHeight="50.0" prefHeight="50.0" style="-fx-background-color: #FAFAFA; -fx-padding: 0 25 0 25; -fx-border-color: #E5E5EA; -fx-border-width: 0 0 1 0; -fx-background-radius: 20 20 0 0;">
                                 <children>
                                    <Label style="-fx-font-weight: bold;" text="Event List" textFill="#111111">
                                       <font><Font size="15.0" /></font>
                                    </Label>
                                 </children>
                              </HBox>
                              
                              <VBox fx:id="containerEvent" />
                              
                           </children>
                        </VBox>
                        
                     </children>
                  </VBox>
               </content>
            </ScrollPane>
            
         </children>
      </HBox>
   </children>
</AnchorPane>